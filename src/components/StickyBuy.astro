---
import { price, book } from '../config';
---
<div class="sticky-buy" data-sticky aria-hidden="true">
  <div class="in">
    <p><strong>{book.title}</strong><span>Ebook ${price('ebook')}, or ${price('bundle')} with the audiobook</span></p>
    <a class="btn btn--yellow" href="/#pricing" tabindex="-1">Get the book</a>
  </div>
</div>

<script is:inline>
  (() => {
    const bar = document.querySelector('[data-sticky]');
    const hero = document.querySelector('[data-hero]');
    const pricing = document.getElementById('pricing');
    if (!bar || !hero || !('IntersectionObserver' in window)) return;
    let pastHero = false, atPricing = false;
    const update = () => {
      const show = pastHero && !atPricing;
      bar.classList.toggle('is-on', show);
      bar.setAttribute('aria-hidden', show ? 'false' : 'true');
      bar.querySelector('a').tabIndex = show ? 0 : -1;
    };
    new IntersectionObserver(([e]) => { pastHero = !e.isIntersecting; update(); }).observe(hero);
    if (pricing) new IntersectionObserver(([e]) => { atPricing = e.isIntersecting; update(); }, { rootMargin: '0px 0px -30% 0px' }).observe(pricing);
  })();
</script>

<style>
  .sticky-buy {
    position: fixed; left: 0; right: 0; bottom: 0; z-index: 60;
    padding: 0.7rem 1rem calc(0.7rem + env(safe-area-inset-bottom, 0px));
    background: var(--navy); color: var(--white);
    box-shadow: 0 -10px 30px rgba(13, 58, 74, 0.25);
    transform: translateY(110%); transition: transform 0.3s ease;
  }
  .sticky-buy.is-on { transform: translateY(0); }
  .in { display: flex; align-items: center; gap: 0.75rem; max-width: 40rem; margin-inline: auto; }
  p { margin: 0; flex: 1; font-family: var(--sans); line-height: 1.25; }
  strong { display: block; font-size: 0.92rem; }
  span { font-size: 0.8rem; color: rgba(255, 255, 255, 0.82); }
  .btn { min-height: 2.75rem; padding: 0.55rem 1.1rem; font-size: 0.92rem; white-space: nowrap; }
  @media (min-width: 900px) { .sticky-buy { display: none; } }
</style>
