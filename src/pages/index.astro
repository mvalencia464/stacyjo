---
import Base from '../layouts/Base.astro';
import BuyButton from '../components/BuyButton.astro';
import Picture from '../components/Picture.astro';
import LoopDiagram from '../components/LoopDiagram.astro';
import { site, media, book, products, launch, socials, youtube, dogs, isSet, price } from '../config';
import { parts, problems, drills, lines, plan, tracks, audiobook } from '../data/book';

const check = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>';

const heroBadges = [`${book.pages}-page PDF`, `${book.drills} step-by-step drills`, 'Instant download', '14-day money-back guarantee'];

const scale = [
  { when: 'Seconds', what: 'Heart rhythm', text: 'Dogs’ and owners’ heart rhythms can line up, especially during quiet rest together, and the effect grows the longer they’ve lived together.' },
  { when: 'Minutes', what: 'Bonding hormones', text: 'In a 2015 study, mutual gazing between dogs and owners raised oxytocin, the “bonding hormone,” in both.' },
  { when: 'Months', what: 'Stress hormones', text: 'In a 2019 study of 58 dogs and their owners, long-term stress levels measured in hair tended to rise and fall together.' },
];

const sources = [
  ['Sundman et al., 2019, Scientific Reports', 'https://liu.se/en/news-item/hunden-speglar-agarens-stress'],
  ['Nagasawa et al., 2015, Science', 'https://carta.anthropogeny.org/node/308531'],
  ['Katayama et al., 2019, Frontiers in Psychology', 'https://www.frontiersin.org/articles/10.3389/fpsyg.2019.01678/text'],
  ['Dog–owner heart-rate co-modulation, 2024, Scientific Reports', 'https://jyx.jyu.fi/jyx/Record/jyx_123456789_97721/Details'],
];

const alsoInside = [
  'The 7-Day Calm Together Plan: one small step a day',
  'A drill quick-reference table, so you can find any drill in seconds',
  'A one-line takeaway at the end of every chapter',
  'Clear notes on when to call your vet or a behavior professional',
  'Research notes and sources, for the curious',
];

const forYou = [
  'Walks feel like a tug-of-war, and you come home more wound up than when you left',
  'Your dog reacts to other dogs, people, bikes, or the doorbell',
  'You’ve tried tips and tricks that worked for a week, then didn’t',
  'You want a calmer dog without yelling, wrestling, or guesswork',
  'You want to understand why your dog does what they do, not just what to do about it',
];

const faqs = [
  ['Is this book right for my dog?', 'It’s written for everyday dog owners: puppies, adult dogs, seniors, rescues, big dogs and small. The method works on the relationship between you and your dog, whatever the breed.'],
  ['What do I need to get started?', 'A leash, treats your dog loves, and about ten minutes a day. A long line (15 to 30 feet) helps for the sniffari and decompression walks.'],
  ['How long until I see a difference?', 'Most drills take 5 to 10 minutes. The 7-Day Plan gets you started in a week. Bigger challenges, like reactivity, take steady practice over several weeks. Every dog moves at their own pace.'],
  ['Does Stacy Jo use punishment?', 'Rewards lead, always. Stacy Jo is a practical, balanced trainer: on occasion she uses clear, low-level corrections, but never for fear, never for a growl, never when a dog is over threshold, and never in anger. Her test for every session: does it end with both of you calmer?'],
  ['Is this a replacement for my vet or a behaviorist?', 'No. The book is general education. If your dog has bitten someone, or their behavior has changed suddenly, please start with your veterinarian and a qualified behavior professional.'],
  ['What format is it?', 'You get the PDF right away, on the thank-you page and in your email. It reads well on phones, tablets, and computers. The bundle adds the audiobook.'],
  ['Who narrates the audiobook?', 'Delia, a natural-sounding AI voice. You hear the complete book, with the tables rewritten so they make sense out loud.'],
  ['Is checkout secure?', 'Yes. Payments are handled by Stripe. Your card details never touch this site.'],
  ['What if it’s not for me?', `Email ${site.email} within 14 days for a full refund.`],
];

const dogLine = isSet(dogs.golden) && isSet(dogs.frenchie)
  ? `At home, that means a golden retriever named ${dogs.golden} and a French bulldog named ${dogs.frenchie}: one big dog, one small dog, and plenty of real-life practice.`
  : 'At home, that means a golden retriever and a French bulldog: one big dog, one small dog, and plenty of real-life practice.';

const jsonld = [
  {
    '@context': 'https://schema.org', '@type': 'Book',
    name: book.title, alternativeHeadline: book.subtitle,
    author: { '@type': 'Person', name: 'Stacy Jo', url: site.url },
    image: media.cover.avif, bookFormat: 'https://schema.org/EBook', numberOfPages: book.pages, inLanguage: 'en',
    offers: (['ebook', 'bundle'] as const).map((k) => ({
      '@type': 'Offer', name: products[k].name, price: price(k).toFixed(2), priceCurrency: 'USD',
      availability: 'https://schema.org/InStock', url: `${site.url}/#pricing`,
    })),
  },
  {
    '@context': 'https://schema.org', '@type': 'Person', name: 'Stacy Jo', jobTitle: 'Dog trainer',
    url: site.url, image: media.headshot.avif, sameAs: socials.map((s) => s.url),
  },
];
---
<Base
  title="The Leash Goes Both Ways: Calm-First Dog Training | Stacy Jo"
  description="Your dog feels what you feel. A calm-first method for the stress loop between you and your dog. 25 drills, 17 chapters, instant PDF."
  jsonld={jsonld}
  sticky
>
  <!-- Hero -->
  <section class="hero band band--teal" data-hero>
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="label">New book by Stacy Jo</p>
        <h1>Your dog feels your stress. <span class="hi">And your calm.</span></h1>
        <p class="lead">Walks, guests, and the doorbell get easier when you calm your end of the leash first.</p>
        <div class="btn-row">
          <BuyButton product="ebook" variant="yellow">Get the book: ${price('ebook')}</BuyButton>
          <a class="btn btn--ghost" href="/free-chapter">Read a free chapter</a>
        </div>
        <p class="hero-bundle">
          <a class="hero-bundle-thumb" href="#audiobook" tabindex="-1" aria-hidden="true">
            <Picture img={media.cover} class="thumb" alt="" />
          </a>
          <span>Prefer to listen? <a href="#audiobook">Get the ebook + audiobook for ${price('bundle')}</a></span>
        </p>
        <ul class="badges">{heroBadges.map((b) => <li class="badge"><Fragment set:html={check} />{b}</li>)}</ul>
      </div>
      <div class="hero-cover">
        <Picture img={media.cover} eager class="cover"
          alt="Book cover of The Leash Goes Both Ways by Stacy Jo, showing Stacy Jo smiling with her golden retriever and French bulldog" />
      </div>
    </div>
  </section>

  <!-- Problems → fixes -->
  <section class="band">
    <div class="wrap">
      <div class="intro">
        <h2 class="accent">You love your dog. Some days it still feels like a second job.</h2>
        <p class="lead">If you’ve ever said one of these, there’s a chapter for it, and a step-by-step drill inside.</p>
      </div>
      <ul class="problems">
        {problems.map((p) => (
          <li class="problem">
            <blockquote>“{p.quote}”</blockquote>
            <div class="fix">
              <span class="fix-label">The fix</span>
              <strong>{p.fix}</strong>
              <span class="ch-tag">Chapter {p.ch}</span>
            </div>
          </li>
        ))}
      </ul>
      <div class="turn-box">
        <p>Most training advice treats you like a remote control: press the right button, get the right behavior. When it doesn’t work, you try a new tool, a new trick, a new trainer. And somewhere along the way, you start to wonder if the problem is you.</p>
        <p class="turn">It isn’t. But you are part of the picture, and that turns out to be the best news of all.</p>
      </div>
    </div>
  </section>

  <!-- The loop -->
  <section class="band band--mist">
    <div class="wrap">
      <div class="center">
        <p class="label">The two-way loop</p>
        <h2 class="accent">Stress travels down the leash. So does calm.</h2>
        <p class="measure">Your dog reads your breathing, your voice, your pace, and the tension in your hand all day long. Their body responds. Then their behavior changes how <em>you</em> feel, and the loop keeps going. Most training only works on the dog’s side. This book works on both.</p>
      </div>
      <LoopDiagram />
      <h3 class="scale-title">What researchers have measured, from seconds to months</h3>
      <ol class="scale">
        {scale.map((s) => (
          <li><span class="when">{s.when}</span><strong class="what">{s.what}</strong><p>{s.text}</p></li>
        ))}
      </ol>
      <p class="caveat measure">These studies are small and show links, not proof that one causes the other. But they point to one very useful idea: you have a lever. You can’t control the squirrel. You can control your next breath.</p>
      <details class="sources">
        <summary>Sources</summary>
        <ul>{sources.map(([t, u]) => <li><a href={u} rel="noopener" target="_blank">{t}</a></li>)}</ul>
      </details>
    </div>
  </section>

  <!-- Excerpt -->
  <section class="band">
    <div class="wrap excerpt-grid">
      <div class="page" aria-label="Excerpt from Chapter 4">
        <p class="page-head">From Chapter 4: Calm Is Contagious</p>
        <p>Rosa’s dog Diesel is a big, goofy pit mix who goes wild when the doorbell rings. Barking, spinning, charging the door.</p>
        <p>Rosa’s response was the one most of us have: “NO! DIESEL! STOP! DIESEL! NO!”</p>
        <p>Loud. Sharp. Fast. Over and over.</p>
        <p>Now imagine you’re Diesel. You hear a strange noise, so you sound the alarm. Then your favorite person starts shouting too.</p>
        <p>To Diesel, Rosa wasn’t stopping the barking.</p>
        <p class="page-punch">She was joining in.</p>
      </div>
      <div class="excerpt-copy">
        <p class="label">Read a page</p>
        <h2 class="accent">The fix starts on your end of the leash.</h2>
        <p>Rosa learns a ten-second skill called the 3-Breath Reset. She practices it when nothing is happening, then with fake doorbells, then for real.</p>
        <p>Two weeks later, the doorbell rings. Read Chapter 4 free to see what Diesel does next.</p>
        <div class="btn-row">
          <a class="btn btn--primary" href="/free-chapter">Read Chapter 4 free</a>
          <a class="btn btn--outline" href="#pricing">Get the whole book</a>
        </div>
      </div>
    </div>
  </section>

  <!-- What's inside -->
  <section class="band band--mist" id="book">
    <div class="wrap">
      <div class="intro">
        <h2 class="accent">Seventeen short chapters. Each one ends with a drill.</h2>
        <p class="lead">Every chapter follows the same rhythm: the problem in words you’ve probably said out loud, what’s really going on, your dog’s side and your side, a drill, and one line to remember.</p>
      </div>
      <div class="toc">
        {parts.map((p) => (
          <section class="toc-part">
            <h3>{p.pillar}<span>{p.note}</span></h3>
            <ol>
              {p.chapters.map((c) => (
                <li value={c.n}>
                  <span class="num" aria-hidden="true">{c.n}</span>
                  <div><strong>{c.title}</strong><p>{c.hook}</p></div>
                </li>
              ))}
            </ol>
          </section>
        ))}
        <section class="toc-part toc-also">
          <h3>Also inside</h3>
          <ul class="checks">{alsoInside.map((a) => <li>{a}</li>)}</ul>
        </section>
      </div>
    </div>
  </section>

  <!-- Drills -->
  <section class="band">
    <div class="wrap">
      <div class="intro">
        <h2 class="accent">{book.drills} step-by-step drills you can start today.</h2>
        <p class="lead">No theory homework. Each drill is short, specific, and built for real life: the front door, the sidewalk, the vet, the couch.</p>
      </div>
      <ul class="chips">{drills.map((d) => <li class="chip">{d}</li>)}</ul>

      <div class="drill">
        <p class="label">Try one right now</p>
        <h3>The 3-Breath Reset <span class="ch-tag">Chapter 4</span></h3>
        <ol>
          <li><strong>Drop the tension.</strong> Unlock your elbow, soften your grip, let a little slack into the leash.</li>
          <li><strong>Soften your body.</strong> Unclench your jaw, soften your knees, and let your eyes leave the trigger.</li>
          <li><strong>The long exhale.</strong> Breathe out slowly, longer than you breathed in. <em>Then</em> give your cue, in your normal voice.</li>
        </ol>
        <p>Ten seconds. Try it before your next walk, and notice what changes: in you first, then in your dog.</p>
      </div>
    </div>
  </section>

  <!-- 7-day plan -->
  <section class="band band--mist">
    <div class="wrap">
      <div class="intro">
        <h2 class="accent">Start tonight with the 7‑Day Calm Together Plan.</h2>
        <p class="lead">One small step a day, ten minutes or less. By day seven, you’ve tried the core of the method and picked your first problem to solve.</p>
      </div>
      <ol class="week">
        {plan.map((d) => (
          <li><span class="day">Day {d.day}</span><strong>{d.title}</strong><p>{d.text}</p></li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Lines -->
  <section class="band band--teal">
    <div class="wrap">
      <h2 class="center">A few lines from the book</h2>
      <ul class="lines">
        {lines.map((l) => (
          <li><blockquote>{l.text}</blockquote><span>Chapter {l.ch}</span></li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Audiobook -->
  <section class="band" id="audiobook">
    <div class="wrap audio-grid">
      <div>
        <p class="label">Ebook + Audiobook</p>
        <h2 class="accent">Prefer to listen? Take the book on your walks.</h2>
        <p class="lead">The complete book as an audiobook: {tracks.length} tracks, {audiobook.runtime}. Start a chapter at the front door, then practice the drill on the sidewalk.</p>
        <ul class="checks">
          <li>Every chapter, plus the 7-Day Plan as its own track</li>
          <li>Tables rewritten for listening, so nothing gets lost</li>
          <li>MP3 files that play on any phone or computer</li>
          <li>{audiobook.narrator}</li>
        </ul>
        <div class="btn-row audio-cta">
          <BuyButton product="bundle" variant="primary">Get the ebook + audiobook: ${price('bundle')}</BuyButton>
        </div>
      </div>
      <div class="tracks">
        <p class="tracks-head">Track list <span>{tracks.length} tracks</span></p>
        <ol>{tracks.map((t) => <li>{t}</li>)}</ol>
      </div>
    </div>
  </section>

  <!-- Who it's for -->
  <section class="band band--mist">
    <div class="wrap who">
      <div>
        <h2 class="accent">This book is for you if…</h2>
        <ul class="checks">{forYou.map((f) => <li>{f}</li>)}</ul>
      </div>
      <aside class="who-not">
        <h3>Start somewhere else if…</h3>
        <p>Your dog has bitten someone, or their behavior has changed suddenly. Please begin with your veterinarian and a qualified behavior professional. This book can support that work, but it shouldn’t replace it.</p>
      </aside>
    </div>
  </section>

  <!-- About -->
  <section class="band" id="about">
    <div class="wrap about">
      <Picture img={media.headshot} class="headshot" alt="Stacy Jo" />
      <div class="measure">
        <h2 class="accent">Hi, I’m Stacy Jo.</h2>
        <p>I’m a dog trainer who teaches a calm-first, balanced approach built on one simple idea: you and your dog shape each other.</p>
        <p>Rewards lead, always. I help owners calm their own side of the leash first, read what their dogs are really saying, and build routines that leave both ends of the leash happier.</p>
        <p>{dogLine}</p>
        <a class="btn btn--outline" href={youtube} rel="noopener" target="_blank">Watch on YouTube</a>
      </div>
    </div>
  </section>

  <!-- Pricing -->
  <section class="band band--mist" id="pricing">
    <div class="wrap">
      <h2 class="accent center">Get the book</h2>
      <p class="center lead price-lead">Everything you need to calm both ends of the leash, starting tonight.</p>
      <div class="plans">
        <article class="plan">
          <h3>{products.ebook.name}</h3>
          <p class="price">{launch.active && <s>${products.ebook.price}</s>}<span>${price('ebook')}</span></p>
          <ul class="checks">
            <li>All {book.chapters} chapters, {book.pages}-page PDF</li>
            <li>{book.drills} step-by-step drills</li>
            <li>The 7-Day Calm Together Plan</li>
            <li>Drill quick-reference table</li>
            <li>Research notes and sources</li>
            <li>Instant download</li>
          </ul>
          <BuyButton product="ebook" variant="outline">Get the book: ${price('ebook')}</BuyButton>
        </article>
        <article class="plan plan--best">
          <p class="tag">Best value</p>
          <h3>{products.bundle.name}</h3>
          <p class="price">{launch.active && <s>${products.bundle.price}</s>}<span>${price('bundle')}</span></p>
          <p class="plus-line">Everything in the ebook, plus:</p>
          <ul class="checks">
            <li>The complete audiobook: {tracks.length} tracks, {audiobook.runtime}</li>
            <li>The 7-Day Plan as its own track</li>
            <li>MP3s for any phone or computer</li>
          </ul>
          <BuyButton product="bundle" variant="yellow">Listen on your walks: ${price('bundle')}</BuyButton>
        </article>
      </div>
      {launch.active && <p class="center launch-note">Launch prices with code <strong>{launch.code}</strong>.</p>}
      <ul class="badges trust">
        <li class="badge"><Fragment set:html={check} />Secure checkout with Stripe</li>
        <li class="badge"><Fragment set:html={check} />Instant download</li>
        <li class="badge"><Fragment set:html={check} />Reads on any device</li>
      </ul>
      <div class="guarantee">
        <svg viewBox="0 0 48 48" aria-hidden="true"><path d="M24 4l16 6v12c0 10-7 18-16 22C15 40 8 32 8 22V10z" fill="#FFD703" stroke="#035875" stroke-width="3" stroke-linejoin="round"/><path d="M16.5 24.5l5 5 10-11" fill="none" stroke="#035875" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <div>
          <h3>14-day money-back guarantee</h3>
          <p>Try the whole method for two weeks. If it isn’t helping, email <a href={`mailto:${site.email}`}>{site.email}</a> for a full refund. No questions asked.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="band">
    <div class="wrap faq">
      <h2 class="accent">Questions</h2>
      <div class="faq-list">
        {faqs.map(([q, a]) => (<details><summary>{q}</summary><p>{a}</p></details>))}
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="band band--teal">
    <div class="wrap center final">
      <h2>Stress travels down the leash. <span class="hi">So does calm.</span></h2>
      <p class="lead measure">Your next walk can be different. It starts with one breath, on your end of the leash.</p>
      <div class="btn-row">
        <BuyButton product="ebook" variant="yellow">Get the book: ${price('ebook')}</BuyButton>
        <BuyButton product="bundle" variant="ghost">Ebook + audiobook: ${price('bundle')}</BuyButton>
      </div>
      <p class="fine"><a href="/free-chapter">Or read a free chapter first</a></p>
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .hero { padding-block: clamp(3rem, 7vw, 5.5rem); overflow: hidden; }
  .hero-grid { display: grid; gap: 2.5rem; align-items: center; }
  .hero h1 { margin-bottom: 0.45em; }
  .hero .lead { max-width: 34rem; }
  .hero .btn-row { margin: 1.75rem 0 0.9rem; }
  .hero-bundle { display: flex; align-items: center; gap: 0.8rem; font-family: var(--sans); font-size: 0.95rem; margin: 0 0 1.4rem; color: rgba(255, 255, 255, 0.92); }
  .hero-bundle a { font-weight: 600; }
  .hero-bundle-thumb { flex: none; line-height: 0; border-radius: 4px; overflow: hidden; box-shadow: 0 6px 16px rgba(0, 0, 0, 0.28); }
  .hero-bundle-thumb :global(img) { display: block; width: 46px; height: auto; }
  .hero-cover { justify-self: center; width: min(78%, 380px); }
  .hero-cover :global(.cover) {
    width: 100%; border-radius: 6px; outline: 1px solid rgba(255, 255, 255, 0.55);
    box-shadow: 0 2px 0 rgba(13, 58, 74, 0.25), 0 30px 60px -18px rgba(13, 58, 74, 0.55);
  }
  @media (min-width: 900px) {
    .hero-grid { grid-template-columns: 1.2fr 0.8fr; gap: 4rem; }
    .hero-cover { width: 100%; max-width: 400px; justify-self: end; }
  }

  .intro { max-width: 46rem; margin-bottom: 2.5rem; }
  .intro .lead { color: var(--muted); }

  /* Problems */
  .problems { list-style: none; margin: 0; padding: 0; display: grid; gap: 1rem; }
  @media (min-width: 700px) { .problems { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1000px) { .problems { grid-template-columns: repeat(3, 1fr); } }
  .problem {
    display: flex; flex-direction: column; justify-content: space-between; gap: 1.25rem;
    padding: 1.4rem 1.4rem 1.2rem; border-radius: var(--radius); background: var(--mist);
  }
  .problem blockquote { margin: 0; font-style: italic; font-size: 1.08rem; line-height: 1.5; color: var(--ink); }
  .fix { display: grid; gap: 0.15rem; padding-top: 0.9rem; border-top: 1px solid rgba(3, 88, 117, 0.15); }
  .fix-label { font-family: var(--sans); font-size: 0.8rem; font-weight: 600; color: var(--teal-deep); }
  .fix strong { font-family: var(--sans); font-weight: 700; color: var(--navy); font-size: 1.05rem; line-height: 1.3; }
  .fix .ch-tag { justify-self: start; margin-top: 0.4rem; }
  .turn-box { max-width: 46rem; margin: 3rem auto 0; text-align: center; }
  .turn { font-family: var(--sans); font-weight: 600; color: var(--navy); font-size: 1.2rem; line-height: 1.45; }

  /* Timescale */
  .scale-title { text-align: center; margin: 3.5rem 0 1.75rem; font-size: 1.15rem; color: var(--ink); }
  .scale { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.75rem; position: relative; }
  .scale li { position: relative; padding-left: 2rem; }
  .scale li::before { content: ''; position: absolute; left: 0; top: 0.35rem; width: 0.9rem; height: 0.9rem; border-radius: 50%; background: var(--yellow); border: 3px solid var(--navy); }
  .scale::before { content: ''; position: absolute; left: 0.55rem; top: 0.8rem; bottom: 2rem; width: 2px; background: rgba(3, 88, 117, 0.25); }
  .when { display: block; font-family: var(--sans); font-weight: 700; font-size: 1.6rem; color: var(--navy); line-height: 1.1; }
  .what { display: block; font-family: var(--sans); font-weight: 600; color: var(--teal-deep); margin: 0.15rem 0 0.4rem; }
  .scale p { margin: 0; font-size: 1rem; }
  @media (min-width: 820px) {
    .scale { grid-template-columns: repeat(3, 1fr); gap: 2.5rem; padding-top: 2.25rem; }
    .scale::before { left: 0; right: 0; top: 0.75rem; bottom: auto; width: auto; height: 2px; }
    .scale li { padding-left: 0; }
    .scale li::before { top: -2.05rem; }
  }
  .caveat { margin: 2.25rem auto 0.75rem; text-align: center; font-style: italic; color: var(--muted); font-size: 1rem; }
  .sources { text-align: center; font-family: var(--sans); font-size: 0.9rem; }
  .sources summary { cursor: pointer; color: var(--navy); font-weight: 600; display: inline-block; }
  .sources ul { list-style: none; padding: 0; margin: 0.75rem 0 0; display: grid; gap: 0.35rem; }

  /* Excerpt */
  .excerpt-grid { display: grid; gap: 2.5rem; align-items: center; }
  @media (min-width: 900px) { .excerpt-grid { grid-template-columns: 1fr 1fr; gap: 4.5rem; } }
  .page {
    position: relative; background: #fffdf6; border-radius: 4px 14px 14px 4px;
