---
import Base from '../layouts/Base.astro';
import { site, legal } from '../config';
---
<Base title="Refunds | Stacy Jo" description="The 14-day money-back guarantee for The Leash Goes Both Ways.">
  <section class="band"><div class="wrap prose">
    <h1>Refunds</h1>
    <p class="fine">Last updated: {legal.updated}</p>
    <p>The ebook and the ebook + audiobook bundle both come with a 14-day money-back guarantee.</p>
    <p>Email <a href={`mailto:${site.email}`}>{site.email}</a> with your order number within 14 days of purchase and you’ll get a full refund. No questions asked.</p>
    <p>Refunds go back to your original payment method through Stripe.</p>
  </div></section>
</Base>
