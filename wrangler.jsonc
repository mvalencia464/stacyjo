{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "stacyjo",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-10-13",
  "r2_buckets": [
    {
      "binding": "DOWNLOADS",
      "bucket_name": "stacyjo-downloads"
    }
  ],
  "vars": {
    // Stripe Payment Link IDs (plink_...), from Stripe → Payment Links → open a link → copy its ID.
    // Optional: orders still match by product name and price without them, but these never break.
    "STRIPE_LINK_EBOOK": "",
    "STRIPE_LINK_BUNDLE": ""
  },
  "services": [
    {
      "binding": "MAILER",
      "service": "stacyjo-mailer"
    }
  ]
}
